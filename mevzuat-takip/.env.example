# Docker (compose.yaml) kullanılıyorsa: veritabanı şifresi (sadece harf/rakam; openssl rand -hex 16).
# MEVZUAT_DB_URL compose tarafından bu şifreyle kurulur; aşağıdaki değer Docker'da kullanılmaz.
MEVZUAT_DB_SIFRE=
# Docker: panelin bu makinede açılacağı port (varsayılan 8000). Tarama saatleri panelden (Tarama sayfası) değişir;
# aşağıdaki sadece ilk değerdir (Türkiye saati), ilk açılışta veritabanına aktarılır.
# MEVZUAT_PANEL_PORT=8000
# MEVZUAT_CALISMA_SAATLERI=06:30,18:00
# Docker: gecelik yedek saati (yedekler ./yedekler klasörüne, 30 gün; sunucu dışına kopyalayın).
# MEVZUAT_YEDEK_SAATI=03:00

# Geliştirme: SQLite dosyası. Sunucu: PostgreSQL.
MEVZUAT_DB_URL=sqlite:///mevzuat.db
# MEVZUAT_DB_URL=postgresql+psycopg://mevzuat:SIFRE@localhost:5432/mevzuat
MEVZUAT_KONULAR=config/konular.toml
MEVZUAT_KAYNAKLAR=config/kaynaklar.toml

# OCR (taranmış PDF'ler). Linux: apt install tesseract-ocr tesseract-ocr-tur → ayar gerekmez.
# Windows'ta Türkçe dil dosyası ayrı klasördeyse:
# MEVZUAT_TESSERACT=C:\Program Files\Tesseract-OCR\tesseract.exe
# MEVZUAT_TESSDATA=C:\Users\<kullanici>\tessdata\best

# Rapor akışı: tarama → onaylayıcıya linksiz bildirim → panelden onay → alıcı gruplarına rapor.
# Onaylayıcılar panel kullanıcılarıdır (mevzuat.cli kullanici-ekle --rol onaylayici).
# Raporun kime gideceği burada DEĞİL: panelde "Alıcı grupları" sayfasında tanımlanır.
MEVZUAT_ADMIN_ALICILARI=bilgi-islem@firma.com.tr
MEVZUAT_EK_EKLE=1
# Bu kadar gün pasif kalan kullanıcı hesabı silinir (ad, e-posta, parola). 0 yazılırsa hiç silinmez.
# MEVZUAT_PASIF_SILME_GUN=30
# Gönderilmiş ya da reddedilmiş raporlar (kalemleriyle) ve denetim kaydı bu kadar gün sonra silinir.
# Onay bekleyen raporlara dokunulmaz. 0 yazılırsa hiç silinmez.
# MEVZUAT_SAKLAMA_GUN=30

# Mail (SMTP). MEVZUAT_SMTP_HOST boşsa mail gönderilmez, giden_mailler/ klasörüne yazılır.
# Gmail: Google Hesabı → Güvenlik → 2 Adımlı Doğrulama açık olmalı → "Uygulama şifreleri"nden
# 16 haneli şifre al. Normal Gmail şifresi ÇALIŞMAZ.
# MEVZUAT_SMTP_HOST=smtp.gmail.com
# MEVZUAT_SMTP_PORT=587
# MEVZUAT_SMTP_KULLANICI=adres@gmail.com
# MEVZUAT_SMTP_SIFRE=xxxxxxxxxxxxxxxx
# MEVZUAT_SMTP_GONDEREN=adres@gmail.com

# Onay paneli
# Oturum çerezini imzalar. En az 32 karakter. Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MEVZUAT_GIZLI_ANAHTAR=
# Panel HTTPS'li bir ters vekil sunucunun arkasındaysa 1 yapın (çerez sadece HTTPS'te gönderilir).
MEVZUAT_HTTPS=0
# İki adımlı doğrulama (telefondaki doğrulayıcı uygulama) herkes için zorunlu. İlk girişte QR ile kurulur.
# Telefonunu kaybeden kullanıcı: mevzuat.cli mfa-sifirla --eposta ...
MEVZUAT_MFA=1
# Panelin kullanıcıların tarayıcıda açtığı adres. Onaylayıcıya giden "Onay bekliyor" mailindeki düğme
# doğrudan o raporu açar (giriş ve iki adımlı doğrulama yine istenir). Boşsa mailde düğme olmaz.
# MEVZUAT_PANEL_ADRESI=https://mevzuat.firma.com.tr
